# Telegram bot token from @BotFather
BOT_TOKEN=

# Your Telegram user ID — only this user can run /stats.
# Find it via @userinfobot. Leave empty to disable /stats entirely.
ADMIN_ID=

# Optional overrides:
# Where temp files are stored (default: ./downloads)
# TEMP_DIR=./downloads
# Absolute paths to binaries if they are not on PATH
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
